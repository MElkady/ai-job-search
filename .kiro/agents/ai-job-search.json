{
  "name": "ai-job-search",
  "description": "AI Job Search agent for Kiro. Same pre-approved commands as .claude/settings.json; loads the CLAUDE.md profile. Generated by tools/sync_kiro.py - do not edit.",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "^bun run \\.agents/skills/jobbank-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^bun run \\.agents/skills/jobdanmark-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^bun run \\.agents/skills/jobindex-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^bun run \\.agents/skills/jobnet-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^bun run \\.agents/skills/linkedin-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^bun run \\.agents/skills/freehire-search/cli/src/cli\\.ts( [^;&|`$()<>\\r\\n]*)?$",
        "^python salary_lookup\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python3 salary_lookup\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python tools/rank_state\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python3 tools/rank_state\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python tools/job_key\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python3 tools/job_key\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python tools/verify_pdf\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python3 tools/verify_pdf\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python tools/verify_layout\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^python3 tools/verify_layout\\.py( [^;&|`$()<>\\r\\n]*)?$",
        "^pdftotext( [^;&|`$()<>\\r\\n]*)?$"
      ]
    }
  },
  "resources": [
    "file://CLAUDE.md",
    "skill://.kiro/skills/*/SKILL.md"
  ]
}
